HOST=127.0.0.1
PORT=8787
MCP_PATH_PREFIX=/mcp

# Required. `chatgpt-computer-control setup` generates a secure value automatically.
VPS_APP_TOKEN=replace_with_at_least_24_random_characters

MAX_OUTPUT_CHARS=12000
MAX_TIMEOUT_SECONDS=600
# OAUTH_TOKEN_TTL_SECONDS=
# MAX_FILE_CONTENT_BASE64_CHARS=12582912
# MAX_FILE_READ_BYTES=5242880
# MAX_DOWNLOAD_TTL_SECONDS=86400

# Computer control
COMPUTER_SCREENSHOT_SETTLE_MS=1200
# DISPLAY=:0
# COMPUTER_MANAGED_X11=1
# COMPUTER_X11_SCREEN=1280x800x24
# COMPUTER_ENABLE_VNC=0
# COMPUTER_VNC_PORT=5909
# CHATGPT_COMPUTER_NATIVE_HELPER=/path/to/helper
