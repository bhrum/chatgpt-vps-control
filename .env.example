HOST=127.0.0.1
PORT=8787
MCP_PATH_PREFIX=/mcp

# Required. `chatgpt-computer-control setup` generates a secure value automatically.
VPS_APP_TOKEN=replace_with_at_least_24_random_characters

MAX_OUTPUT_CHARS=12000
MAX_TIMEOUT_SECONDS=600
# OAUTH_TOKEN_TTL_SECONDS=
# MAX_FILE_CONTENT_BASE64_CHARS=12582912
# MAX_FILE_READ_BYTES=5242880
# MAX_DOWNLOAD_TTL_SECONDS=86400

# Dynamic device gateway. Enable DEVICE_GATEWAY_LISTEN only on the central MCP.
# DEVICE_GATEWAY_LISTEN=1
# DEVICE_GATEWAY_PATH=/agent
# DEVICE_GATEWAY_TOKEN=replace_with_at_least_32_random_characters
# DEVICE_CENTRAL_ID=central-vps
# DEVICE_CENTRAL_NAME=Central VPS

# Dynamic device agent. Set these on a computer that should connect to the central MCP.
# DEVICE_GATEWAY_URL=wss://control.example.com/agent
# DEVICE_GATEWAY_TOKEN=the_same_gateway_token_as_the_central_mcp
# DEVICE_GATEWAY_TOKEN_KEYCHAIN_SERVICE=chatgpt-device-control # macOS alternative to storing the token in this file
# DEVICE_GATEWAY_TOKEN_KEYCHAIN_ACCOUNT=device-gateway-token
# DEVICE_ID=my-computer
# DEVICE_NAME=My Computer
# DEVICE_GATEWAY_IP_FAMILY=4
# DEVICE_LOCAL_MCP_URL=http://127.0.0.1:8787/mcp

# Computer control
COMPUTER_SCREENSHOT_SETTLE_MS=1200
# DISPLAY=:0
# COMPUTER_MANAGED_X11=1
# COMPUTER_X11_SCREEN=1280x800x24
# COMPUTER_ENABLE_VNC=0
# COMPUTER_VNC_PORT=5909
# CHATGPT_COMPUTER_NATIVE_HELPER=/path/to/helper
# CHATGPT_COMPUTER_CODESIGN_IDENTITY=certificate_sha1_fingerprint # keep fixed for stable macOS authorization across source updates
# CHATGPT_COMPUTER_TEAM_ID=your_apple_team_id # keeps the designated requirement stable across certificate renewal

# Semantic accessibility
# COMPUTER_CDP_ENDPOINTS=http://127.0.0.1:9222
# COMPUTER_CDP_PORTS=9222,9225
# NO_AT_BRIDGE=0
# GTK_MODULES=gail:atk-bridge
