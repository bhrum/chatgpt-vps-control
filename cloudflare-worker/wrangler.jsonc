{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chatgpt-device-control",
  "main": "src/index.js",
  "compatibility_date": "2026-08-18",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "DEVICE_REGISTRY",
        "class_name": "DeviceRegistry"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DeviceRegistry"]
    }
  ]
}
